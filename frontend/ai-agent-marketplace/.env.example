# AI Agent Marketplace Frontend - Environment Variables
# Copy this file to .env.local and fill in your values

# ========== REQUIRED ==========
# Deployed Soroban contract ID
VITE_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC endpoint
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (Testnet or Mainnet)
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# USDC Contract ID (Testnet or Mainnet)
# Testnet: CBIELSO6KZLFBUSGZ47QRYCYMHK4D2H5IMKBORJGUJVAVKZOQK4D7IAJ
# Mainnet: CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
VITE_USDC_CONTRACT_ID=CBIELSO6KZLFBUSGZ47QRYCYMHK4D2H5IMKBORJGUJVAVKZOQK4D7IAJ

# ========== OPTIONAL ==========
# Analytics
VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TESTNET_BANNER=true